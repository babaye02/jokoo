{
  "expo": {
    "name": "Jokoo",
    "slug": "frontend",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jokoo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.jokoomobiledev.b94ufz",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Ajoutez une photo de profil ou de mission.",
        "NSPhotoLibraryUsageDescription": "Sélectionnez des photos pour votre profil.",
        "NSPhotoLibraryAddUsageDescription": "Sauvegardez vos reçus de mission.",
        "NSMicrophoneUsageDescription": "Envoyez des messages vocaux aux prestataires.",
        "NSLocationWhenInUseUsageDescription": "Trouvez les prestataires proches de vous.",
        "NSContactsUsageDescription": "Partagez Jokoo avec vos proches.",
        "NSFaceIDUsageDescription": "Connectez-vous rapidement et en toute sécurité.",
        "NSUserTrackingUsageDescription": "Personnalisez votre expérience avec des offres pertinentes.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Jokoo",
        "LSApplicationQueriesSchemes": ["wave", "orangemoney", "tel", "mailto", "sms", "https", "http", "maps", "comgooglemaps"],
        "UIBackgroundModes": [],
        "UIRequiresFullScreen": false,
        "UIStatusBarStyle": "UIStatusBarStyleDefault",
        "UIViewControllerBasedStatusBarAppearance": true,
        "CFBundleLocalizations": ["fr", "en"],
        "CFBundleDevelopmentRegion": "fr"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.jokoomobiledev.b94ufz",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sélectionnez des photos pour votre profil.",
          "cameraPermission": "Ajoutez une photo de profil ou de mission."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}
