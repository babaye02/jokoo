{
  "expo": {
    "name": "Jokoo",
    "slug": "frontend",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jokoo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.jokoomobiledev.b94ufz",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Prenez des photos pour votre profil et vos annonces.",
        "NSPhotoLibraryUsageDescription": "Ajoutez des photos à vos annonces et profil.",
        "NSPhotoLibraryAddUsageDescription": "Enregistrez vos reçus de mission.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Jokoo",
        "LSApplicationQueriesSchemes": ["wave", "orangemoney", "tel", "mailto", "sms"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.jokoomobiledev.b94ufz",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ajoutez des photos à vos annonces et profil.",
          "cameraPermission": "Prenez des photos pour votre profil et vos annonces."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}
