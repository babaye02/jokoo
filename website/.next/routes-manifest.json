      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/prestataires/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/prestataires/[id]/reserver",
      "regex": "^/prestataires/([^/]+?)/reserver(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/prestataires/(?<nxtPid>[^/]+?)/reserver(?:/)?$"
    }
  ],
  "staticRoutes": [
